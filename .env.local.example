# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Cloud TTS (server-side ONLY — never expose to client)
GOOGLE_TTS_API_KEY=your-google-tts-api-key

# Lemon Squeezy
LEMON_SQUEEZY_WEBHOOK_SECRET=your-webhook-secret
LEMON_SQUEEZY_STORE_ID=your-store-id
LEMON_SQUEEZY_CHECKOUT_URL_STARTER=https://your-store.lemonsqueezy.com/checkout/buy/starter-variant-id
LEMON_SQUEEZY_CHECKOUT_URL_PRO=https://your-store.lemonsqueezy.com/checkout/buy/pro-variant-id

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
